# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required to run.

# Model provider — required.
ANTHROPIC_API_KEY=

# Web search for destination research. Without it the agent still plans,
# costs, and builds itineraries, but cannot look anything up.
TAVILY_API_KEY=

# Observability. Optional, but recommended — traces every agent step,
# including subagent calls, to LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=travel-agent

# Flight/lodging source: "sample-data" (default) or "duffel".
#   sample-data — synthetic, clearly-labelled offers. No account needed.
#   duffel      — live flight search via Duffel. Lodging still returns
#                 sample data; Duffel Stays is not wired up.
TRAVEL_AGENT_PROVIDER=sample-data

# Required when TRAVEL_AGENT_PROVIDER=duffel. Create one in the Duffel
# dashboard under "Developer test mode" — test tokens start with
# duffel_test_ and hit synthetic inventory. The integration is read-only:
# it searches offers and never creates an order, so nothing is ever booked
# and no payment is taken, on a test or a live token.
DUFFEL_API_TOKEN=

# How long Duffel waits for airlines to respond, in ms (2000-60000).
# Lower it for faster, thinner results. Our HTTP timeout tracks this.
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
