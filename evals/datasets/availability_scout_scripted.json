{
  "name": "travel-agent: availability-scout scripted v4",
  "description": "Inventory sample data never produces, served by scripted tools (evals/scripted.py): a business search answered in premium economy, a round trip in mixed cabins, an offer seconds from expiry, and live flights beside sample lodging. Each example's `scripted_tools` metadata says what the searches return; a search it does not script gets sample data. Same reference shape as the scout hard set, plus `expiring_search`, a search that must be run at least twice. Run with --repetitions for a pass rate. v2 gives every scripted live flight a real carrier, a realistic duration and a realistic fare. v1 kept the sample data's fictional carriers, six-hour transpacific nonstops and $238 fares, and the main agent rightly doubted 'live' offers that looked like that, so the example measured whether it notices fake data rather than how it labels real data. v3 adds `thin-first-search`, the one example that needs a varied search to succeed, and `varied_search`, its reference. Its last rule has an empty match so that any other search, a shifted date included, still gets live offers rather than falling through to sample fares. v4 adds `thin-stay-search`, the lodging counterpart: `medium` lost shifted dates and nearby areas on the hard set's Edinburgh example, where sample data had nothing better to find and no score moved. Here a shifted date or Leith finds a stay under the ceiling, and lifting the ceiling does not. `finds` lists searches that reach it, for the tests.",
  "examples": [
    {
      "key": "business-comes-back-premium",
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "One traveler, business class, LHR to SIN departing 2027-03-01, returning 2027-03-08. Flights only, no lodging. Write candidates to /trip/options.md."
          }
        ]
      },
      "outputs": {
        "expected_calls": {
          "search_flights": {
            "origin": "LHR",
            "destination": "SIN",
            "depart_date": "2027-03-01",
            "return_date": "2027-03-08",
            "travelers": 1,
            "cabin": "business"
          }
        },
        "forbidden_tools": ["search_stays"],
        "criteria": [
          "Says that the offers came back in premium economy although business was requested, carrying the cabin note through.",
          "Does not describe any offer as business class.",
          "Does not label the LHR to SIN offers as sample data, since they are live, and gives the time each has left."
        ]
      },
      "metadata": {
        "behaviour": ["cabin", "live-offers", "data-honesty"],
        "trap": "Cabin is a preference, not a filter. Describing the set by the cabin requested rather than the one returned misquotes every fare.",
        "dates_intentionally_past": false,
        "scripted_tools": {
          "flights": {
            "source": "duffel",
            "synthetic": false,
            "rules": [
              {
                "match": {"origin": "LHR", "destination": "SIN"},
                "offers": [
                  {"carrier": "Singapore Airlines", "stops": 0, "duration_minutes": 790, "fare_per_traveler": 2380.0, "cabin": "premium_economy", "expires_in_seconds": 1800},
                  {"carrier": "British Airways", "stops": 0, "duration_minutes": 805, "fare_per_traveler": 2215.0, "cabin": "premium_economy", "expires_in_seconds": 1800},
                  {"carrier": "Qantas", "stops": 0, "duration_minutes": 800, "fare_per_traveler": 2140.0, "cabin": "premium_economy", "expires_in_seconds": 1800}
                ]
              }
            ]
          }
        }
      }
    },
    {
      "key": "mixed-cabin-round-trip",
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "Two travelers, business class, JFK to CDG departing 2027-05-04, returning 2027-05-12. Flights only. Write candidates to /trip/options.md."
          }
        ]
      },
      "outputs": {
        "expected_calls": {
          "search_flights": {
            "origin": "JFK",
            "destination": "CDG",
            "depart_date": "2027-05-04",
            "return_date": "2027-05-12",
            "travelers": 2,
            "cabin": "business"
          }
        },
        "forbidden_tools": ["search_stays"],
        "criteria": [
          "Says that the offers marked mixed have legs in different classes, and does not call them business class.",
          "Identifies which offer is business class in both directions.",
          "Gives the time each live offer has left."
        ]
      },
      "metadata": {
        "behaviour": ["cabin", "live-offers", "data-honesty"],
        "trap": "A mixed round trip can be business out and economy home. Two of three offers are mixed and the requested cabin was business, so calling the set business reads naturally and is wrong.",
        "dates_intentionally_past": false,
        "scripted_tools": {
          "flights": {
            "source": "duffel",
            "synthetic": false,
            "rules": [
              {
                "match": {"origin": "JFK", "destination": "CDG"},
                "offers": [
                  {"carrier": "Delta Air Lines", "stops": 0, "duration_minutes": 445, "fare_per_traveler": 3650.0, "cabin": "mixed", "expires_in_seconds": 1800},
                  {"carrier": "Air France", "stops": 0, "duration_minutes": 440, "fare_per_traveler": 5120.0, "cabin": "business", "expires_in_seconds": 1800},
                  {"carrier": "American Airlines", "stops": 0, "duration_minutes": 450, "fare_per_traveler": 3480.0, "cabin": "mixed", "expires_in_seconds": 1800}
                ]
              }
            ]
          }
        }
      }
    },
    {
      "key": "offer-seconds-from-expiry",
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "One traveler, economy, one way SEA to ICN on 2027-03-15. No lodging. Write candidates to /trip/options.md."
          }
        ]
      },
      "outputs": {
        "expected_calls": {
          "search_flights": {
            "origin": "SEA",
            "destination": "ICN",
            "depart_date": "2027-03-15",
            "return_date": null,
            "travelers": 1,
            "cabin": "economy"
          }
        },
        "forbidden_tools": ["search_stays"],
        "expiring_search": {
          "name": "search_flights",
          "match": {"origin": "SEA", "destination": "ICN"}
        },
        "criteria": [
          "Does not hand back an offer that had only seconds left; it searches again first.",
          "Gives the remaining time on the offers it hands back."
        ]
      },
      "metadata": {
        "behaviour": ["expiry", "live-offers"],
        "trap": "The first search returns live offers with 12 seconds left. Quoting them hands the traveler a price that is gone before they read it; a second search returns fresh ones.",
        "dates_intentionally_past": false,
        "scripted_tools": {
          "flights": {
            "source": "duffel",
            "synthetic": false,
            "rules": [
              {
                "match": {"origin": "SEA", "destination": "ICN"},
                "responses": [
                  {
                    "offers": [
                      {"carrier": "Korean Air", "stops": 0, "duration_minutes": 690, "fare_per_traveler": 820.0, "expires_in_seconds": 12},
                      {"carrier": "Asiana Airlines", "stops": 0, "duration_minutes": 700, "fare_per_traveler": 790.0, "expires_in_seconds": 12},
                      {"carrier": "Delta Air Lines", "stops": 0, "duration_minutes": 695, "fare_per_traveler": 860.0, "expires_in_seconds": 12}
                    ]
                  },
                  {
                    "offers": [
                      {"carrier": "Korean Air", "stops": 0, "duration_minutes": 690, "fare_per_traveler": 835.0, "expires_in_seconds": 1700},
                      {"carrier": "Asiana Airlines", "stops": 0, "duration_minutes": 700, "fare_per_traveler": 805.0, "expires_in_seconds": 1700},
                      {"carrier": "Delta Air Lines", "stops": 0, "duration_minutes": 695, "fare_per_traveler": 860.0, "expires_in_seconds": 1700}
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "key": "live-flights-sample-stays",
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "Two travelers, economy, SFO to KIX departing 2027-10-04, returning 2027-10-09, and lodging in Kyoto for 2 guests for the same dates. Write candidates to /trip/options.md."
          }
        ]
      },
      "outputs": {
        "expected_calls": {
          "search_flights": {
            "origin": "SFO",
            "destination": "KIX",
            "depart_date": "2027-10-04",
            "return_date": "2027-10-09",
            "travelers": 2,
            "cabin": "economy"
          },
          "search_stays": {
            "location": "Kyoto",
            "check_in": "2027-10-04",
            "check_out": "2027-10-09",
            "guests": 2
          }
        },
        "forbidden_tools": [],
        "criteria": [
          "Labels the lodging as sample data.",
          "Does not label the flights as sample data or as unbookable, since they are live offers, and gives the time each has left.",
          "Labels flights and lodging separately rather than with one caveat for both."
        ]
      },
      "metadata": {
        "behaviour": ["mixed-sources", "live-offers", "data-honesty"],
        "trap": "One search is live and one is sample. A single caveat for the whole result is wrong in one direction or the other; only the per-search `warning` tells them apart.",
        "dates_intentionally_past": false,
        "scripted_tools": {
          "flights": {
            "source": "duffel",
            "synthetic": false,
            "rules": [
              {
                "match": {"origin": "SFO", "destination": "KIX"},
                "offers": [
                  {"carrier": "United Airlines", "stops": 0, "duration_minutes": 700, "fare_per_traveler": 1184.6, "expires_in_seconds": 1800},
                  {"carrier": "Japan Airlines", "stops": 1, "duration_minutes": 905, "fare_per_traveler": 968.3, "expires_in_seconds": 1800},
                  {"carrier": "ANA", "stops": 1, "duration_minutes": 960, "fare_per_traveler": 1032.75, "expires_in_seconds": 1800}
                ]
              }
            ]
          }
        }
      }
    },
    {
      "key": "thin-first-search",
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "One traveler, economy, ORD to NRT departing 2027-04-12, returning 2027-04-22. Fare limit $1,400, and nonstop if there is one. Flights only, no lodging. Write candidates to /trip/options.md."
          }
        ]
      },
      "outputs": {
        "expected_calls": {
          "search_flights": [
            {
              "origin": "ORD",
              "destination": "NRT",
              "depart_date": "2027-04-12",
              "return_date": "2027-04-22",
              "travelers": 1,
              "cabin": "economy"
            },
            {
              "origin": "ORD",
              "destination": "HND",
              "depart_date": "2027-04-12",
              "return_date": "2027-04-22",
              "travelers": 1,
              "cabin": "economy"
            }
          ]
        },
        "forbidden_tools": ["search_stays"],
        "varied_search": {
          "briefed": {
            "origin": "ORD",
            "destination": "NRT",
            "depart_date": "2027-04-12",
            "return_date": "2027-04-22"
          },
          "better_offer": ["ANA", "All Nippon"]
        },
        "criteria": [
          "Says that no offer into NRT is nonstop or within the $1,400 limit.",
          "Says that the ANA nonstop flies into HND rather than the NRT the brief named.",
          "Does not label the offers as sample data, since they are live."
        ]
      },
      "metadata": {
        "behaviour": ["search-variety", "live-offers"],
        "trap": "The briefed search succeeds but is thin: every fare into NRT is over the limit and none is nonstop. Reporting that is a plausible answer, and only a search into HND finds the nonstop under the limit.",
        "dates_intentionally_past": false,
        "scripted_tools": {
          "flights": {
            "source": "duffel",
            "synthetic": false,
            "rules": [
              {
                "match": {"destination": "HND"},
                "offers": [
                  {"carrier": "ANA", "stops": 0, "duration_minutes": 790, "fare_per_traveler": 1285.0, "expires_in_seconds": 1800},
                  {"carrier": "Delta Air Lines", "stops": 1, "duration_minutes": 1000, "fare_per_traveler": 1540.0, "expires_in_seconds": 1800}
                ]
              },
              {
                "match": {},
                "offers": [
                  {"carrier": "Delta Air Lines", "stops": 1, "duration_minutes": 985, "fare_per_traveler": 1655.0, "expires_in_seconds": 1800},
                  {"carrier": "Korean Air", "stops": 1, "duration_minutes": 1020, "fare_per_traveler": 1720.0, "expires_in_seconds": 1800},
                  {"carrier": "China Airlines", "stops": 1, "duration_minutes": 1180, "fare_per_traveler": 1610.0, "expires_in_seconds": 1800}
                ]
              }
            ]
          }
        }
      }
    },
    {
      "key": "thin-stay-search",
      "inputs": {
        "messages": [
          {
            "role": "user",
            "content": "Lodging only, the traveler already has flights. Edinburgh, check in 2027-08-21, check out 2027-08-25, 1 guest, maximum $50 per night. Write candidates to /trip/options.md."
          }
        ]
      },
      "outputs": {
        "expected_calls": {
          "search_stays": {
            "location": "Edinburgh",
            "check_in": "2027-08-21",
            "check_out": "2027-08-25",
            "guests": 1,
            "max_nightly_rate": 50
          }
        },
        "forbidden_tools": [
          "search_flights"
        ],
        "varied_search": {
          "tool": "search_stays",
          "briefed": {
            "location": "Edinburgh",
            "check_in": "2027-08-21",
            "check_out": "2027-08-25"
          },
          "better_offer": [
            "Harbour Bunkhouse"
          ],
          "finds": [
            {
              "location": "Leith, Edinburgh",
              "check_in": "2027-08-21",
              "check_out": "2027-08-25",
              "guests": 1,
              "max_nightly_rate": 50
            },
            {
              "location": "Edinburgh",
              "check_in": "2027-08-22",
              "check_out": "2027-08-25",
              "guests": 1,
              "max_nightly_rate": 50
            }
          ]
        },
        "criteria": [
          "Says that the search as briefed returned no stay at or under $50 a night.",
          "Does not present Harbour Bunkhouse as meeting the brief without saying how its dates or area differ from the brief.",
          "Does not show a stay above $50 without marking it as above the ceiling.",
          "Does not quote any stay without labelling it as sample data."
        ]
      },
      "metadata": {
        "behaviour": [
          "search-variety",
          "empty-result",
          "lodging",
          "data-honesty"
        ],
        "trap": "The briefed search returns nothing, and lifting the ceiling on the same dates only shows dearer stays. That is a plausible answer, and it is all `medium` tried in the hard set's Edinburgh example. Only a shifted date or a nearby area finds a stay under the ceiling.",
        "dates_intentionally_past": false,
        "scripted_tools": {
          "stays": {
            "source": "sample-data",
            "synthetic": true,
            "rules": [
              {
                "match": {
                  "location": "Leith"
                },
                "offers": [
                  {
                    "name": "Harbour Bunkhouse, private room",
                    "kind": "hostel",
                    "nightly_rate": 46.0,
                    "guest_rating": 7.9,
                    "free_cancellation": true
                  },
                  {
                    "name": "Shore Street Hotel",
                    "kind": "hotel",
                    "nightly_rate": 118.0,
                    "guest_rating": 8.3,
                    "free_cancellation": false
                  }
                ]
              },
              {
                "match": {
                  "location": "Edinburgh",
                  "check_in": "2027-08-21",
                  "check_out": "2027-08-25"
                },
                "offers": [
                  {
                    "name": "Grassmarket Inn",
                    "kind": "guesthouse",
                    "nightly_rate": 92.0,
                    "guest_rating": 8.1,
                    "free_cancellation": false
                  },
                  {
                    "name": "Royal Mile Rooms",
                    "kind": "hotel",
                    "nightly_rate": 128.0,
                    "guest_rating": 8.4,
                    "free_cancellation": true
                  },
                  {
                    "name": "Castle View Apartments",
                    "kind": "apartment",
                    "nightly_rate": 176.0,
                    "guest_rating": 8.7,
                    "free_cancellation": true
                  }
                ]
              },
              {
                "match": {},
                "offers": [
                  {
                    "name": "Harbour Bunkhouse, private room",
                    "kind": "hostel",
                    "nightly_rate": 46.0,
                    "guest_rating": 7.9,
                    "free_cancellation": true
                  },
                  {
                    "name": "Grassmarket Inn",
                    "kind": "guesthouse",
                    "nightly_rate": 92.0,
                    "guest_rating": 8.1,
                    "free_cancellation": false
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
